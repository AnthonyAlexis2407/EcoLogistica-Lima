{
  "ci": {
    "collect": {
      "startServerCommand": "PYTHONPATH=src/backend python -m uvicorn app.main:app --port 8000",
      "startServerReadyPattern": "Application startup complete",
      "startServerReadyTimeout": 60000,
      "url": ["http://localhost:8000/"],
      "numberOfRuns": 3,
      "settings": {
        "onlyCategories": ["performance"],
        "chromeFlags": "--no-sandbox --headless=new"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9, "aggregationMethod": "median" }],
        "first-contentful-paint": ["error", { "maxNumericValue": 1000, "aggregationMethod": "median" }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 1400, "aggregationMethod": "median" }],
        "total-blocking-time": ["error", { "maxNumericValue": 85, "aggregationMethod": "median" }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.02, "aggregationMethod": "median" }],
        "total-byte-weight": ["error", { "maxNumericValue": 1153434, "aggregationMethod": "median" }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
